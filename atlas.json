{
  "ai": {
    "autonomy": "agentic",
    "orchestrator": "atlas",
    "preferred_models": [
      {
        "id": "google/gemini-2.5-pro",
        "provider": "google"
      },
      {
        "id": "anthropic/claude-3-7-sonnet",
        "provider": "anthropic"
      },
      {
        "id": "openai/gpt-4o",
        "provider": "openai"
      }
    ]
  },
  "context": {
    "architecture": "progressive-context-architecture",
    "budget_profile": "medium",
    "deep_recursion": {
      "enabled": false,
      "experimental": true
    },
    "methodology": "lean-progressive-context",
    "mode": "progressive",
    "profiles": {
      "large": {
        "context_hard_tokens": 32000,
        "context_target_tokens": 16000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 3,
        "output_hard_tokens": 6000,
        "output_target_tokens": 3000
      },
      "medium": {
        "context_hard_tokens": 16000,
        "context_target_tokens": 8000,
        "max_delegation_depth": 1,
        "max_expansion_rounds": 2,
        "output_hard_tokens": 3000,
        "output_target_tokens": 1500
      },
      "small": {
        "context_hard_tokens": 6000,
        "context_target_tokens": 3000,
        "max_delegation_depth": 0,
        "max_expansion_rounds": 1,
        "output_hard_tokens": 1000,
        "output_target_tokens": 500
      }
    },
    "runtime": {
      "completed_context_ttl": "0d",
      "database": ".atlas/runtime/atlas.db",
      "failed_context_ttl": "7d"
    }
  },
  "documentation": {
    "audiences": [
      "user",
      "developer",
      "operations",
      "agent"
    ],
    "canonical_format": "markdown",
    "entrypoint": "docs/ATLAS.md",
    "site": {
      "enabled": true,
      "generated": true,
      "public_internal_views": true,
      "source": "docs"
    },
    "virtual_chunking": true
  },
  "features": [
    "tui-editor",
    "modal-editing",
    "embedded-terminal",
    "proactive-lsp",
    "tree-sitter-syntax",
    "file-explorer",
    "git-scm",
    "task-runner",
    "plugins",
    "theming",
    "i18n-localization",
    "splits-multicursor",
    "markdown-rich-preview"
  ],
  "framework": {
    "name": "project-atlas-framework",
    "version": "0.4.2"
  },
  "goals": {
    "active_goal": null,
    "active_phase": "P00"
  },
  "intelligence": {
    "distinguish_observed_estimated": true,
    "enabled": true,
    "path": ".atlas/history/project-intelligence.json",
    "task_reports": true,
    "track_cost": true,
    "track_input_tokens": true,
    "track_output_tokens": true
  },
  "orchestration": {
    "autonomy": "agentic",
    "orchestrator": "atlas",
    "protocol": "POP"
  },
  "project": {
    "description": "Fast, lightweight, extensible terminal IDE (TUI) with modal editing, embedded PTY terminal, proactive LSP diagnostics, task runner, and dynamic plugin/theming ecosystem.",
    "name": "oride",
    "title": "Oride Terminal IDE",
    "type": [
      "cli",
      "tui",
      "code-editor",
      "developer-tool"
    ]
  },
  "protocol": {
    "compatible": "\u003e=3 \u003c4",
    "version": 3
  },
  "quality": {
    "accessibility": true,
    "memory": "high",
    "performance": "high",
    "security": "high",
    "startup": "critical"
  },
  "risk": [
    "terminal-pty-portability",
    "lsp-path-availability",
    "tree-sitter-c-abi"
  ],
  "stack": {
    "editor": [
      "oride-core",
      "ropey"
    ],
    "git": [
      "gix",
      "git-cli"
    ],
    "i18n": [
      "oride-i18n",
      "toml"
    ],
    "languages": [
      "rust",
      "oriscript",
      "c",
      "bash",
      "markdown"
    ],
    "search": [
      "ripgrep",
      "ignore"
    ],
    "syntax": [
      "tree-sitter",
      "tree-sitter-highlight"
    ],
    "terminal": [
      "portable-pty",
      "vt100"
    ],
    "ui": [
      "ratatui",
      "crossterm"
    ]
  },
  "version": 3
}
