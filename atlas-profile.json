{
  "version": 2,
  "project": {
    "name": "oride",
    "title": "Oride Terminal IDE",
    "type": ["cli", "tui", "code-editor", "developer-tool"],
    "description": "Fast, lightweight, extensible terminal IDE (TUI) with modal editing, embedded PTY terminal, proactive LSP diagnostics, task runner, and dynamic plugin/theming ecosystem."
  },
  "stack": {
    "languages": ["rust", "oriscript", "c", "bash", "markdown"],
    "ui": ["ratatui", "crossterm"],
    "editor": ["oride-core", "ropey"],
    "syntax": ["tree-sitter", "tree-sitter-highlight"],
    "terminal": ["portable-pty", "vt100"],
    "git": ["gix", "git-cli"],
    "search": ["ripgrep", "ignore"],
    "i18n": ["oride-i18n", "toml"]
  },
  "features": [
    "tui-editor",
    "modal-editing",
    "embedded-terminal",
    "proactive-lsp",
    "tree-sitter-syntax",
    "file-explorer",
    "git-scm",
    "task-runner",
    "plugins",
    "theming",
    "i18n-localization",
    "splits-multicursor",
    "markdown-rich-preview"
  ],
  "quality": {
    "performance": "high",
    "startup": "critical",
    "memory": "high",
    "security": "high",
    "accessibility": true
  },
  "risk": [
    "terminal-pty-portability",
    "lsp-path-availability",
    "tree-sitter-c-abi"
  ],
  "ai": {
    "orchestrator": "atlas",
    "autonomy": "agentic",
    "preferred_models": [
      {
        "id": "google/gemini-2.5-pro",
        "provider": "google"
      },
      {
        "id": "anthropic/claude-3-7-sonnet",
        "provider": "anthropic"
      },
      {
        "id": "openai/gpt-4o",
        "provider": "openai"
      }
    ]
  }
}
