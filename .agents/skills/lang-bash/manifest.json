{
  "id": "lang-bash",
  "name": "Bash Strict Defensive Engineering",
  "version": 1,
  "schema_version": 2,
  "purpose": "Enforce Bash strict mode (set -euo pipefail), ShellCheck clean execution, explicit quoting of all parameter expansions, trap handlers for resource cleanup, and zero eval.",
  "risk_level": "medium",
  "modes": [
    "implementation",
    "review",
    "testing"
  ],
  "inputs": [
    "Source code",
    "Project configuration",
    "Task acceptance criteria"
  ],
  "outputs": [
    "Hardened source code",
    "Verification evidence",
    "Test evidence"
  ],
  "requires": [
    "clean-code",
    "testing-quality"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/bash-defensive.md"
  ],
  "templates": [
    "templates/bash-verification-report.md"
  ],
  "checks": [
    "checks/bash-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe_runner.sh"
  ],
  "required_evidence": [
    "test",
    "lint"
  ],
  "stop_conditions": [
